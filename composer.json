{
    "name": "smartschool/smartschool-ethiopia",
    "type": "project",
    "description": "Smart School Management System for Ethiopian Schools",
    "keywords": ["school", "management", "ethiopia", "laravel", "smartschool"],
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2",
        "andegna/calender": "^2.2",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "haruncpi/laravel-id-generator": "^1.0",
        "intervention/image": "^2.6",
        "laravel/breeze": "^1.3",
        "laravel/framework": "^8.12",
        "laravel/tinker": "^2.5",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^8.0",
        "picqer/php-barcode-generator": "^2.2",
        "realrashid/sweet-alert": "^3.2",
        "simplesoftwareio/simple-qrcode": "^4.2"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
